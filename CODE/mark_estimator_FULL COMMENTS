    def __init__(self, root):
        # Store the reference to the root Tkinter window container object inside the class instance
        self.root = root
        # Set the operating system window title bar text for the application window
        self.root.title("Student Mark Estimator System")
        # Define the initial startup window dimensions (750 pixels wide by 660 pixels high)
        self.root.geometry("750x660")
        # Enforce structural window restrictions by setting a minimum width and height limit
        self.root.minsize(700, 580)

        # Initialize an empty instance variable to store our loaded pandas DataFrame matrix
        self.df = None
        # Initialize an empty instance variable to track the raw absolute path to our selected CSV file
        self.file_path = None
        # Initialize an empty variable to hold the output path string of the estimated file export
        self.last_exported_file = None
        # Initialize an empty variable to record the header name of the student ID column
        self.id_col = None
        # Initialize an empty list array designed to store the names of all assessment columns
        self.assessment_cols = []
        # Initialize an empty list array to map specific missing row details to the UI components
