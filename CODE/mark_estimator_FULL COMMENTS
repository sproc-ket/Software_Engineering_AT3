    # Define a helper function to safely append system status print instructions into logs
    def log_message(self, message, clear=False):
        # Temporarily enable editing on the locked console text window container area
        self.txt_output.config(state=tk.NORMAL)
        # If the clear parameter option evaluates to true, empty the full text window space
        if clear:
            self.txt_output.delete("1.0", tk.END)
        # Append the new log string item onto the terminal area line row entry fields
        self.txt_output.insert(tk.END, message + "\n")
        # Lock user manual input access rules on text boxes following command executions
        self.txt_output.config(state=tk.DISABLED)

    # Open system browsing dialogues to handle user file picks securely
    def load_csv(self):
        # Launch file selector popup window filtered to display file extensions ending in .csv
        selected_file = filedialog.askopenfilename(
            filetypes=[("CSV Files", "*.csv")]
        )
        # If the user closes out the popup browser module without confirming an item selection, return
        if not selected_file:
            return

        # Delegate to the shared loading method to avoid code duplication
        self._load_csv_from_path(selected_file)

    # Handle drag and drop file events to automatically load CSV files
    def handle_drop(self, event):
        # Extract the file path from the drop event data (tkinterdnd2 returns it in curly braces)
        file_path = event.data.strip('{}')

        # Verify that the dropped file has a .csv extension
        if not file_path.lower().endswith('.csv'):
            # Show a warning popup if the user drops a non-CSV file
            messagebox.showwarning(
                "Invalid File Type",
                "Please drop a CSV file (.csv extension required)."
            )
            return

        # Call the existing load_csv logic by simulating a file selection
        # We'll create a modified version that accepts a path parameter
        self._load_csv_from_path(file_path)

    # Internal helper method to load CSV from a specific path (used by both browse and drag-drop)
    def _load_csv_from_path(self, selected_file):
        # Initialize a protective execution monitoring block to isolate structural parsing bugs
        try:
            # Command the pandas engine library to process and map target file strings into matrices
            temp_df = pd.read_csv(selected_file)

            # Verification rule: stop execution if the selected data sheet contains zero entries
            if temp_df.empty:
                # Direct a system modal warning box to alert users to document issues
                messagebox.showerror("Error", "The chosen CSV file is empty.")
                # Halt current function tracks to prevent processing broken layout components
                return
            # Verification rule: stop execution if data sheets contain fewer than two header columns
            if len(temp_df.columns) < 2:
                # Direct a structural layout warning popup alerting users to column data errors
                messagebox.showerror(
                    "Error",
                    "CSV must contain at least a Student Identifier and one assessment column.",
                )
                # Halt current function tracks to prevent processing broken layout components
                return

            # Save the valid parsed dataset into our main memory storage DataFrame
            self.df = temp_df
            # Save the full system absolute location tracking path string link to our input file
            self.file_path = selected_file
            # Map the first left column category field layout to act as student search tags
            self.id_col = self.df.columns[0]
            # Map all remaining dataset categories on the right as valid task entries lists
            self.assessment_cols = list(self.df.columns[1:])

            # Clear out any past document export trackers when opening separate file rows
            self.last_exported_file = None
            # Disable text viewer utilities until user predictions are successfully exported
            self.btn_open_file.config(state=tk.DISABLED)

            # Update the interface file row label to display the short filename of our loaded dataset
            self.lbl_file_status.config(
                text=os.path.basename(selected_file),
                font=("Arial", 9, "bold"),
            )
            # Call the style manager immediately to color the newly updated label appropriately
            self._update_theme_styles()

            # Print out a clear success confirmation message on the user status terminal interface
            self.log_message(
                f"Success: Loaded file successfully: {os.path.basename(selected_file)}",
                clear=True,
            )

            # Scan the active document fields to flag missing data values immediately
            self.scan_for_missing_data()

        # Handle runtime issues like open file locks safely to prevent software crashes
        except Exception as e:
            # Surface raw read errors onto alert prompts to help with manual file troubleshooting
            messagebox.showerror(
                "File Read Error", f"Could not open or parse file:\n{str(e)}"
            )

    # Scan dataset indexes to look for empty cells that need to be processed
    def scan_for_missing_data(self):
        # Clear out text entry list fields inside our active missing items interface components
        self.listbox_missing.delete(0, tk.END)
        # Clear out old indexing maps to start fresh for our search scan run
        self.missing_records = []

        # Find rows where any assessment column is NaN (missing a score)
        missing_mask = self.df[self.assessment_cols].isna().any(axis=1)
        # Isolate the rows containing missing marks into a separate filtered subset
        missing_df = self.df[missing_mask]

        # If the filtered subset contains zero rows, then our tracking document is completely filled
        if missing_df.empty:
            # Print a success notification message to the user text field to notify them data is filled
            self.log_message(
                "Success: No missing grades found in this entire dataset."
            )
            # Keep calculation triggers locked since there are no values left to resolve
            self.btn_estimate.config(state=tk.DISABLED)
            self.btn_run_all.config(state=tk.DISABLED)
            # Exit early since there is no missing work left to calculate
            return

        # Loop through the rows containing missing marks to isolate empty cells
        for _, row in missing_df.iterrows():
            # Extract the unique Student ID string key from the current row
            student_id = row[self.id_col]
            # Check every individual assessment column for this specific student row
            for col in self.assessment_cols:
                # If the value in the cell is missing (NaN), record it as an estimation target
                if pd.isna(row[col]):
                    # Format a fixed-width readout string to neatly align item records in the listbox
                    display_str = f"Student ID: {str(student_id):<12} | Missing Task: {col}"
                    # Add the formatted text line onto the bottom of the visual problem tracker listbox
                    self.listbox_missing.insert(tk.END, display_str)
                    # Store the ID and column details as a dictionary in our internal tracking list
                    self.missing_records.append(
                        {"id": student_id, "column": col}
                    )

        # Unlock the estimation buttons since there are now valid target items available to process
        self.btn_estimate.config(state=tk.NORMAL)
        self.btn_run_all.config(state=tk.NORMAL)
        # Print a status summary to update the user on the total number of empty items found
        self.log_message(
            f"Found {len(self.missing_records)} missing item(s). Highlight one above to process, or click 'Run All Estimations'."
        )

    # Process selections and hand parameters over to machine learning execution branches
    def process_estimation(self):
        # Retrieve the index number of the item currently clicked inside the listbox tracking queue
        selection = self.listbox_missing.curselection()
        # If the user clicks run without first highlighting an entry, show a warning prompt
        if not selection:
            # Display a quick modal reminder box notifying the user that an entry choice is required
            messagebox.showwarning(
                "Selection Required",
                "Please click and select a specific row item from the list box above.",
            )
            # Exit further processing paths until a valid selection is made
            return

        # Extract the raw integer index out of the selection tuple securely
        selected_index = selection[0]
        # Look up the matching entry details from our internal data list using the index
        target_info = self.missing_records[selected_index]
        # Extract the student identifier key connected to the highlighted target entry
        target_id = target_info["id"]
        # Extract the target column category string connected to the highlighted target entry
        target_col = target_info["column"]

        # Run the dataset through our machine learning engine to calculate the missing grade
        predicted_mark, metrics = self.predict_mark(target_id, target_col)

        # Clear out past output readouts and format a clean header for the results panel
        self.log_message("", clear=True)
        self.log_message("=========================================")
        self.log_message("           ESTIMATION OUTPUT             ")
        self.log_message("=========================================")
        # Print the identified student ID target value inside the results terminal console area
        self.log_message(f"Student Target ID : {target_id}")
        # Print the name of the missing assessment field being estimated inside the logs
        self.log_message(f"Assessment Column : {target_col}")
        # Print out the final calculated machine learning prediction score result entry
        self.log_message(f"Estimated Mark    : {predicted_mark}")
        self.log_message("-----------------------------------------")
        # Print out supporting statistical summary context to build trust in our output metrics
        self.log_message("Supporting Context Baseline Calculations:")
        # Iterate over the calculated summary metrics dictionary to display baseline results
        for k, v in metrics.items():
            # Format each key-value pair as a clean bullet point line entry
            self.log_message(f" - {k}: {v}")
        # Print the closing divider element to wrap up the calculation results log entry
        self.log_message("=========================================")

        # Export the updated data values out into an external file sheet immediately
        self.export_results(target_id, target_col, predicted_mark)

    # NEW: Process all missing estimations in one batch operation
    def process_all_estimations(self):
        # Check if there are any missing records to process
        if not self.missing_records:
            messagebox.showwarning(
                "No Missing Data",
                "There are no missing marks to estimate."
            )
            return

        # Store the total count of items to process
        total_count = len(self.missing_records)

        # Clear the output log and print a header for the batch operation
        self.log_message("", clear=True)
        self.log_message("=" * 60)
        self.log_message("           BATCH ESTIMATION - RUN ALL")
        self.log_message("=" * 60)
        self.log_message(f"Processing {total_count} missing mark(s)...\n")

        # Create a list to store all estimation results for the summary
        estimation_results = []

        # Iterate through each missing record and estimate the mark
        for idx, target_info in enumerate(self.missing_records, 1):
            target_id = target_info["id"]
            target_col = target_info["column"]

            # Log progress for the current item
            self.log_message(f"[{idx}/{total_count}] Processing: Student {target_id}, Column {target_col}")

            # Run the ML prediction
            predicted_mark, metrics = self.predict_mark(target_id, target_col)

            # Update the DataFrame with the predicted mark
            self.df.loc[self.df[self.id_col] == target_id, target_col] = predicted_mark

            # Store the result for the summary
            estimation_results.append({
                "student_id": target_id,
                "column": target_col,
                "estimated_mark": predicted_mark
            })

            self.log_message(f"    -> Estimated Mark: {predicted_mark}\n")

        # Export all results to a single file
        dir_name, file_name = os.path.split(self.file_path)
        output_path = os.path.join(dir_name, f"estimated_{file_name}")

        try:
            # Write the updated DataFrame to CSV
            self.df.to_csv(output_path, index=False)

            # Update the last exported file tracker
            self.last_exported_file = output_path
            # Enable the file viewer button
            self.btn_open_file.config(state=tk.NORMAL)

            # Print summary information
            self.log_message("=" * 60)
            self.log_message("           BATCH ESTIMATION COMPLETE")
            self.log_message("=" * 60)
            self.log_message(f"Total marks estimated: {total_count}")
            self.log_message(f"\nResults exported to:\n -> {output_path}")
            self.log_message("=" * 60)

            # Show success popup
            messagebox.showinfo(
                "Batch Estimation Complete",
                f"Successfully estimated {total_count} missing mark(s)!\n\nFile written to:\n{output_path}\n\nYou can now open it in your text editor."
            )

            # Re-scan to update the missing data list (should be empty or reduced)
            self.scan_for_missing_data()

        except Exception as e:
            messagebox.showerror(
                "Export Failure Error",
                f"Could not export results:\n{str(e)}"
            )

    # Build regression models on clean slices of data to predict missing values
    def predict_mark(self, target_id, target_col):
        # Create a list of feature columns by omitting the target column from the assessments list
        feature_cols = [c for c in self.assessment_cols if c != target_col]

        # Safety Fallback 1: If there is only one assessment column, we can't use multi-feature ML
        if not feature_cols:
            # Calculate the class average score for this single category column instead
            historical_avg = round(self.df[target_col].mean(), 1)
            # Return the calculated class baseline score alongside an explicit fallback notation entry
            return historical_avg, {"Fallback Route": "Global Class Column Mean"}

        # Extract all complete rows that contain scores for both features and the target column
        train_data = self.df.dropna(subset=[target_col] + feature_cols)

        # Safety Fallback 2: We need at least two complete rows of student data to train a linear model
        if len(train_data) < 2:
            # Fall back to using the simple class historical average for this column category
            historical_avg = round(self.df[target_col].mean(), 1)
            # Return the class average and specify that there wasn't enough data for machine learning
            return historical_avg, {
                "Fallback Route": "Global Class Mean (Insufficient complete rows for ML)"
            }

        # Isolate the specific student data row that contains our missing value target
        # Added .iloc[0] to guarantee we isolate exactly one row to avoid multi-row calculations
        target_row = self.df[self.df[self.id_col] == target_id].iloc[0]

        # Safety Fallback 3: Check if the student is missing grades across other feature columns too
        # Adjusted row check logic to match single-row Series architecture safely
        if target_row[feature_cols].isna().any():
            # Calculate the direct scalar mean score of this row Series safely with no array conversion errors
            student_avg = round(target_row[feature_cols].mean(), 1)
            # Return the student's personal performance average with an explicit fallback tag
            return student_avg, {
                "Fallback Route": "Student Row Mean (Multiple missing marks)"
            }

        # Isolate our training input features (X) from the rows that have complete data
        X_train = train_data[feature_cols]
        # Isolate our training target targets (y) from the rows that have complete data
        y_train = train_data[target_col]

        # Convert single student row Series back to a clean 2D dataframe for scikit-learn models
        X_predict = pd.DataFrame([target_row[feature_cols]])

        # Instantiate a standard linear regression model object from scikit-learn
        model = LinearRegression()
        # Train the model by mapping inputs to known scores inside our complete datasets
        model.fit(X_train, y_train)

        # Generate a mathematical prediction based on the target student's feature scores
        raw_pred = model.predict(X_predict)

        # Extract the numeric scalar using [0] to keep calculation tracking stable
        final_pred = round(max(0.0, min(100.0, raw_pred[0])), 1)

        # Build a supporting metrics dictionary to show users the background data trends
        # Formatted the internal calculations mean parameters to avoid numpy multi-array errors
        metrics = {
            f"Class Baseline Mean for {target_col}": round(
                self.df[target_col].mean(), 2
            ),
            "Target Student Mean on other tests": round(
                target_row[feature_cols].mean(), 2
            ),
            "Robust Sample Sizes Used for Training": len(train_data),
        }

        # Return the final calculated prediction score alongside our supporting context details
        return final_pred, metrics

    # Save calculated estimations into local files without overwriting raw datasets
    def export_results(self, target_id, target_col, predicted_mark):
        # Update the empty cell inside our local pandas DataFrame with the predicted mark
        self.df.loc[self.df[self.id_col] == target_id, target_col] = (
            predicted_mark
        )

        # Split the absolute directory folder string away from the filename structure components
        dir_name, file_name = os.path.split(self.file_path)
        # Create a new output file name by adding the 'estimated_' prefix to the original name
        output_path = os.path.join(dir_name, f"estimated_{file_name}")

        # Wrap file export calls in a protective handling routine block to catch write permissions locks
        try:
            # Command pandas to write the updated dataframe matrix out into a new CSV file
            self.df.to_csv(output_path, index=False)

            # Save the export location string link into our text file viewer tracker variable
            self.last_exported_file = output_path
            # Unlock the file browser shortcut button since the output file has been successfully saved
            self.btn_open_file.config(state=tk.NORMAL)

            # Print out file path link confirmation lines inside our console tracking window area
            self.log_message(f"\nDocument updated file exported to:\n -> {output_path}")
            # Launch a success popup window confirming that the document was successfully written
            messagebox.showinfo(
                "Export Success",
                f"Successfully calculated results!\nFile written out to:\n\n{output_path}\n\nYou can now open it in your text editor below.",
            )

            # Re-scan data fields immediately to update problem listings and clear resolved tasks
            self.scan_for_missing_data()
        # Handle file writing errors (like when a file is open in Excel and locked by the OS) safely
        except Exception as e:
            # Launch a system warning alert window displaying the technical write failure message
            messagebox.showerror(
                "Export Failure Error",
                f"Could not print output onto hard disk storage systems:\n{str(e)}",
            )

    # Launch plain-text system editor processes to open generated data logs
    def open_exported_file(self):
        # Confirm that an output path exists and that the generated document is on the disk
        if not self.last_exported_file or not os.path.exists(self.last_exported_file):
            # Show an error alert notification stating that the target file can no longer be found
            messagebox.showerror("Error", "The estimated file could not be found.")
            # Halt further launch tracks to prevent program execution crashes
            return

        # Wrap external process execution requests in a handling routine block to capture OS limits
        try:
            # Check if the hosting system environment evaluates to a native Windows OS platform
            if sys.platform == "win32":
                # Try to open with Notepad first, fall back to default application if Notepad fails
                try:
                    subprocess.Popen(["notepad.exe", self.last_exported_file])
                except FileNotFoundError:
                    os.startfile(self.last_exported_file)
            # Check if the hosting system environment evaluates to a Apple macOS platform instead
            elif sys.platform == "darwin":
                # Launch macOS subprocess parameters targeting the default app for the file type
                subprocess.Popen(["open", self.last_exported_file])

            # Log the text editor launch action to confirm it was sent to the OS successfully
            self.log_message(f"Opened file in text editor: {os.path.basename(self.last_exported_file)}")
        # Handle cases where the operating system prevents running subprocess tasks
        except Exception as e:
            # Present a backup instruction message dialog helping users find the file manually
            messagebox.showerror(
                "Open Failed",
                f"Could not open text editor automatically:\n{str(e)}\n\nYou can find it at:\n{self.last_exported_file}"
            )


